{
  "expo": {
    "name": "Nuveen",
    "slug": "nuveen",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "nuveen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0C0C"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NFCReaderUsageDescription": "Nuveen needs NFC access to scan your tag and stop alarms.",
        "NSAlarmKitUsageDescription": "Nuveen needs alarm access so your alarm can ring on the lock screen, in silent mode and in Focus.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ]
      },
      "bundleIdentifier": "com.nuveen.alarm",
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "TAG"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "permissions": [
        "android.permission.NFC",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.DISABLE_KEYGUARD"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.nuveen.alarm",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FEFAEF"
      }
    },
    "notification": {
      "color": "#F4C07A"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#F4C07A",
          "sounds": [
            "./assets/sounds/alarm.mp3",
            "./assets/sounds/alarm_10.caf",
            "./assets/sounds/alarm_20.caf",
            "./assets/sounds/alarm_30.caf",
            "./assets/sounds/alarm_40.caf",
            "./assets/sounds/alarm_50.caf",
            "./assets/sounds/alarm_60.caf",
            "./assets/sounds/alarm_70.caf",
            "./assets/sounds/alarm_80.caf",
            "./assets/sounds/alarm_90.caf",
            "./assets/sounds/alarm_100.caf",
            "./assets/sounds/preview_10.caf",
            "./assets/sounds/preview_20.caf",
            "./assets/sounds/preview_30.caf",
            "./assets/sounds/preview_40.caf",
            "./assets/sounds/preview_50.caf",
            "./assets/sounds/preview_60.caf",
            "./assets/sounds/preview_70.caf",
            "./assets/sounds/preview_80.caf",
            "./assets/sounds/preview_90.caf",
            "./assets/sounds/preview_100.caf"
          ]
        }
      ],
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1dc210bc-3d6f-4595-96e8-173e253d1036"
      }
    },
    "owner": "lucas_fs"
  }
}
